# =============================================================================
# コンテナ用 zsh 設定
#
# ホストの ~/.zshrc から、コンテナ内で意味を持つ設定だけを移植したもの。
# 移植していないもの: Homebrew / fnm / nvm / Volta / Go / macOS 固有の PATH、
# および docker・podman のエイリアス（コンテナ内に CLI が無いため）。
# ロケール（LANG / LC_ALL）は Dockerfile の ENV が権威。
#
# エイリアス・補完・履歴・プロンプト・プラグインは対話 TTY でのみ読み込む。
# AI エージェントのシェル（非 TTY）は素の zsh のまま動かす。
#
# 理由: エージェントは起動時に .zshrc を shell snapshot へ取り込み、全ツール
# 呼び出しで再現する。そのため chpwd の ls 出力や ANSI がコマンド出力を汚し、
# プロンプト関数は COLUMNS=0 でゼロ除算し、エイリアスは権限 deny の文字列
# マッチ（展開前の文字列を見る）をすり抜ける。
# =============================================================================

# 非 TTY 向けの最小プロンプト。フック・コマンド置換・ANSI・COLUMNS 依存なし。
PROMPT='%n@%m %~ %# '

[[ -o interactive && -t 1 ]] || return

# =============================================================================
# ここから下は対話 TTY 専用
# =============================================================================

# =============================================================================
# エイリアス
# =============================================================================
alias his='history'
alias ..='cd ../'
alias ...='cd ../..'
alias ....='cd ../../..'
alias y='yarn'
alias x='exit'
alias ll='ls -la'
alias hisall='history 1'
alias hisgrep='history 1 | grep'
alias sz='source ~/.zshrc'

# エイリアス: git 系
# push 系のエイリアスは置かない。エージェントのシェルに漏れた場合、権限設定の
# deny（`git push` の文字列マッチ）を素通りして push できてしまうため。
alias g='git'
alias gs='git status'
alias gb='git branch'
alias gc='git checkout'
alias gct='git commit'
alias gg='git grep'
alias ga='git add'
alias gd='git diff'
alias gl='git log'
alias gcma='git checkout master'
alias gfu='git fetch upstream'
alias gfo='git fetch origin'
alias gmod='git merge origin/develop'
alias gmud='git merge upstream/develop'
alias gmom='git merge origin/master'
alias gcm='git commit -m'
alias gst='git stash'
alias gsl='git stash list'
alias gsu='git stash -u'
alias gsp='git stash pop'

# =============================================================================
# Zsh基本設定
# =============================================================================

autoload -Uz compinit
autoload -Uz colors && colors # 色を使用出来るようにする

compinit -u

export CLICOLOR=1

setopt prompt_subst # プロンプトが表示されるたびにプロンプト文字列を評価、置換する
setopt print_eight_bit # 日本語ファイル名を表示可能にする
setopt auto_cd # cd なしでもディレクトリ移動
setopt no_beep # ビープ音の停止
setopt nolistbeep # ビープ音の停止(補完時)
setopt auto_pushd # cd [TAB] で以前移動したディレクトリを表示

# ヒストリ (履歴) を保存、数を増やす
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

setopt share_history # 同時に起動した zsh の間でヒストリを共有する
setopt hist_ignore_dups # 直前と同じコマンドの場合はヒストリに追加しない
setopt hist_ignore_all_dups # 同じコマンドをヒストリに残さない
setopt hist_ignore_space # スペースから始まるコマンド行はヒストリに残さない
setopt hist_reduce_blanks # ヒストリに保存するときに余分なスペースを削除する
setopt hist_save_no_dups # 重複するコマンドが保存されるとき、古い方を削除する。

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:default' menu select=1
setopt correct
setopt pushd_ignore_dups
setopt extended_glob

WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'

# cdの後にlsを実行
chpwd() { ls -ltr }

# 区切り文字の設定
autoload -Uz select-word-style
select-word-style default
zstyle ':zle:*' word-chars "_-./;@"
zstyle ':zle:*' word-style unspecified

# コマンドを途中まで入力後、historyから絞り込み
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^P" history-beginning-search-backward-end
bindkey "^N" history-beginning-search-forward-end

# =============================================================================
# プロンプト設定（関数定義）
# =============================================================================

# プロンプト用の色とスタイル変数を事前定義
typeset -g reset='%{\e[0m%}'
typeset -g path_text_color='255m%}'
typeset -g path_background_color='031m%}'
typeset -g black='000m%}'
typeset -g option_text='%{\e[38;5;'
typeset -g option_background='%{\e[30;48;5;'
typeset -g branch_background_color='083m%}'
typeset -g branch_text_color='240m%}'
typeset -g inazuma_color='000m%}'
typeset -g inazuma_background_color='227m%}'
typeset -g environment_text_color='255m%}'
typeset -g environment_background_color='057m%}'

# precmd関数の定義
function precmd () {
  # 1行あける
  print

  dir="${option_background}${path_background_color}${option_text}${path_text_color}"

  # 左上に表示するカレントディレクトリ名の表示設定
  top_left="${dir}%~${reset}"

  option_branch_background='%{\e[30;48;5;'

  current_branch=`git rev-parse --abbrev-ref HEAD 2> /dev/null`
  branch_set="${option_branch_background}${branch_background_color}$current_branch"

  # 右上に表示するブランチ名の表示設定
  top_right="${branch_set}${reset}"

  # スペースの長さを計算
  # テキストを装飾する場合、エスケープシーケンスをカウントしないようにします
  invisible='%([BSUbfksu]|([FK]|){*})'
  leftwidth=${#${(S%%)top_left//$~invisible/}}
  rightwidth=${#${(S%%)top_right//$~invisible/}}

  # COLUMNS が 0 の環境（端末幅を取得できない場合）でゼロ除算しないよう既定値を置く
  local cols=${COLUMNS:-80}
  (( cols > 0 )) || cols=80
  padwidth=$(($cols - (($leftwidth) + ($rightwidth)) % $cols))

  print -P $top_left${(r:$padwidth:: :)}$top_right
}

# プロンプト用関数の定義
function inazuma_set {
  typeset -g inazuma_set=${option_background}${inazuma_background_color}${option_text}${inazuma_color}⚡
  typeset -g inazuma_right_triangle_set=${option_background}${environment_background_color}${option_text}${inazuma_background_color}
  print "${inazuma_set}${reset}${inazuma_right_triangle_set}"
}

function environment_set {
  typeset -g environment_right_triangle_set=${option_background}${black}${option_text}${environment_background_color}
  echo "${option_text}${environment_text_color}%n@%m${reset}${environment_right_triangle_set}${reset} %# "
}

# プロンプトの設定
PROMPT='$(inazuma_set)$(environment_set)'
# 現在時刻
RPROMPT=$'%{\e[38;5;251m%}%D{%Y/%m/%d %a} %*%{\e[m%}'
TMOUT=1
TRAPALRM() {
  zle reset-prompt
}

# =============================================================================
# プラグインの読み込み（最後に実行）
# =============================================================================

# apt の zsh-syntax-highlighting / zsh-autosuggestions（Dockerfile で導入）
if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# プロンプトを再描画（初回起動時の表示を確実にする）
precmd
